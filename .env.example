# --- Database ---------------------------------------------------------------
# Neon: paste the connection strings exactly as the dashboard shows them
# (the sslmode / channel_binding options are handled by the app).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=
# Local Postgres from docker-compose instead:
# DATABASE_URL=postgresql://menged:menged@localhost:5432/menged

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling          # polling = laptop / no HTTPS needed; webhook = server
WEBHOOK_BASE_URL=              # https://your-host.example.com (webhook mode only)
WEBHOOK_SECRET=change-me
ADMIN_TELEGRAM_IDS=            # comma-separated user ids allowed to run /simulate (empty = everyone)

# --- Maps (all free) --------------------------------------------------------
ORS_API_KEY=                   # openrouteservice.org token; without it routing uses OSRM
USER_AGENT=MengedBot/1.0       # identifies the app to the OpenStreetMap services

# --- Voice --------------------------------------------------------------------
TTS_ENABLED=true               # gTTS voice notes (text is always sent too)

# --- Tuning (optional; see app/config.py for every threshold) -----------------
# MIN_GAP_S=45
# WINDOW_MAX=4
# APPROACHING_M=500
# ARRIVED_M=50
