# --- Database ---------------------------------------------------------------
# Neon: paste the connection strings exactly as the dashboard shows them
# (the sslmode / channel_binding options are handled by the app).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_POOLED=
# Local Postgres from docker-compose instead:
# DATABASE_URL=postgresql://menged:menged@localhost:5432/menged

# --- Telegram ---------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling          # polling = laptop / no HTTPS needed; webhook = server
WEBHOOK_BASE_URL=              # https://your-host.example.com (webhook mode; on Render it is taken from RENDER_EXTERNAL_URL)
WEBHOOK_SECRET=               # webhook mode only: any random string, 16+ characters (Render generates one)
ADMIN_TELEGRAM_IDS=            # comma-separated user ids allowed to run /simulate (empty = everyone)

# --- Maps (all free) --------------------------------------------------------
ORS_API_KEY=                   # openrouteservice.org token; without it routing uses OSRM
USER_AGENT=MengedBot/1.0       # identifies the app to the OpenStreetMap services

# --- Voice --------------------------------------------------------------------
TTS_ENABLED=true               # gTTS voice notes (text is always sent too)

# --- Tuning ------------------------------------------------------------------
# Starting values from the plan. Change here, then restart the server.
# Distances are metres and times are seconds unless the name says otherwise.
# Every other setting (search bounding box, service URLs, ...) is in app/config.py.

# Trip phases
APPROACHING_M=500              # "Getting close" when this far from the destination...
APPROACHING_S=300              # ...or this many seconds away (whichever comes first)
NEXT_M=150                     # "Your destination is next"
NEXT_S=60
ARRIVED_M=50                   # "You have arrived" (needs 2 points in a row inside this)
MAX_ACCURACY_M=100             # ignore GPS points less accurate than this
STALE_AFTER_S=120              # no location for this long -> ask to share again
END_AFTER_S=600                # no location for this long -> end the trip

# How often the bot speaks
MIN_GAP_S=45                   # at least this long between two messages
WINDOW_S=300                   # at most WINDOW_MAX messages in any WINDOW_S
WINDOW_MAX=4
TIME_LEFT_MARKS_MIN=15,10,5    # "About N minutes left" announcements
LANDMARK_RADIUS_M=100          # announce a landmark when passing within this distance
STILL_HERE_AFTER_S=180         # chatty mode: "still on X" after this much silence

# Food suggestions
FOOD_RADIUS_M=500              # cafés and restaurants counted within this distance
FOOD_MIN_PLACES=2              # offer only when at least this many are nearby
FOOD_OFFER_EVERY_S=600         # at most one offer per this interval
FOOD_MIN_TRIP_S=600            # no offers on trips shorter than this

# Routing and timers
ROUTING_PROFILE=driving-car    # or foot-walking (OpenRouteService profiles)
TICK_SECONDS=30                # background timer: stale checks and time-based rules
TRIP_CARD_EVERY_S=15           # how often the pinned trip card is refreshed
PURGE_POINTS_AFTER_H=24        # delete raw location points this long after a trip ends
